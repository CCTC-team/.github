# Local-tooling artefacts that may show up in `git status` but are not
# part of this repo: host dotfiles bind-mounted by dev sandboxes, IDE
# state, per-user editor/agent config. Do not commit.

# Shell config
.bash_profile
.bashrc
.profile
.zprofile
.zshrc

# Other host-level config
.gitconfig
.gitmodules
.ripgreprc
.mcp.json

# IDE
.idea
.idea/
.vscode/

# Per-user agent / editor state
.claude/
