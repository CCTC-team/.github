# yaml-language-server: $schema=./.github/compliance.schema.json
#
# Compliance metadata for this repository.
# Canonical schema: CCTC-team/.github/compliance.schema.json
# Auto-stubbed by the compliance-drift workflow. Review every TODO before
# merging — the stub assumes a UK academic CTU EDC posture (gcp-critical,
# GAMP 5, no FDA/EMA submission, no EU sites, no clinical decisions).

schema_version: 3

# Must match the `regulatory_tier` org custom property set on this repo.
# - gcp-critical     — captures, transforms, or validates trial data
# - gcp-supporting   — trial metadata, no patient data (eTMF, CTMS, QMS)
# - data-protection  — personal data, no trial nexus
# - none             — pure infrastructure (this file shouldn't exist)
regulatory_tier: gcp-critical

# GAMP 5 software category:
#   3 = off-the-shelf, unconfigured
#   4 = configured off-the-shelf (e.g. RAVE/REDCap as deployed)
#   5 = custom code (most CCTC repos)
gamp_category: 5

# UK CT Regs (as amended by SI 2025/538, in force 28 April 2026) require
# 25-year retention for trial records on applications submitted on or
# after that date. Pre-amendment trials remain on the 5-year rule under
# the 2004 Regs — confirm which regime applies before locking this in.
retention_years: 25

# Regulatory pillars — clusters of related regulations. The granular
# citation register lives in the CTU's QMS / SOPs. Mark each pillar
# considered, including the ones you ruled out: an inspector wants to see
# that you thought about international submission and (correctly) said no,
# not that you silently omitted it.
regulatory_pillars:
  - pillar: uk-statutory
    status: in-scope
    notes: TODO — describe the trial activity. Bundles UK CT Regs 2004 (as amended by SI 2025/538), UK-GDPR, DPA 2018, NHS-DSPT, HRA Transparency. Add CAG-S251 detail here if processing unconsented PID.

  - pillar: mhra-csv-di
    status: in-scope
    notes: ICH E6 (R3), MHRA GxP-DI, MHRA CSV-for-GCP. Standard for any gcp-critical system.

  - pillar: infra-security
    status: in-scope
    notes: TODO — confirm the hosting environment's Cyber Essentials Plus / ISO 27001 posture.

  - pillar: international-ehr-standards
    status: out-of-scope
    notes: UK-only academic trial — no FDA or EMA submission planned. Revisit if the sponsor or destination changes.

  - pillar: eu-ct-regulation
    status: out-of-scope
    notes: No EU sites. Revisit if cross-border recruitment is added.

  - pillar: samd-aimd
    status: out-of-scope
    notes: System captures and stores trial data; does not make or guide clinical decisions.

# Critical-to-Quality factors (CCTU/FRM129) this system supports.
# The software's fit-for-purpose validation is itself a CtQ factor
# under ICH E6(R3) Principle 6. Cite the FRM129 entry so an inspector
# can trace CtQ factor -> risk register -> requirement -> V&V evidence.
ctq_factors:
  - frm129_ref: TODO-FRM129-<trial>#<row>
    tier: critical          # critical | important
    notes: TODO — which trial CtQ factor this system safeguards.

# QMS documents that govern this system's validation and risk
# management — the pointer from source control into the QMS.
governing_documents:
  - ref: CCTU/SOP040
    title: Risk Assessment Process for CTIMPs
    role: risk-assessment
  - ref: CCTU/FRM129
    title: Critical to Quality Factors Form
    role: ctq-identification
  - ref: TODO-CCTU/SOP-CSV
    role: csv

# Inspector-readiness fields (required for gcp-critical). These answer
# the questions an MHRA inspector actually asks. Fill them in honestly —
# they're a contract with the inspector, not marketing.
audit_trail_kind: extractable        # extractable | read-only | append-only | none
account_model: named                 # named | named-with-roles | shared | mixed
pid_boundary: separated              # separated | commingled | none
csv_evidence: TODO-url-to-CSV-pack   # URL or repo path to URS/FS/IQ/OQ/PQ + risk assessment

requirements:
  audit_trail: required
  electronic_signatures: required
  validation_documentation: required
  change_control: formal
  access_review_frequency: quarterly

contacts:
  qa_lead: TODO@cctc-team
  data_protection_officer: TODO@cctc-team

last_reviewed: "2026-05-26"      # Drift workflow templates this to today's date when it creates the stub.
review_cadence_months: 6

# Paths in this repo that constitute the validated state. The traceability
# gate workflow checks that any PR touching these paths is linked to an
# issue with non-empty Risk ID and Requirement ID. Omit this field
# entirely to run the gate in strict mode (every PR gated regardless of
# what it changes) — strict mode is the safe default until you've thought
# about your repo's structure.
#
# Use gitignore-style globs. Quote any pattern containing spaces.
validated_paths:
  - src/**
  - tests/**
  - user_requirement_specification/**
  # - "Feature Tests/**"           # uncomment for REDCap V&V repos

# Paths inside a validated_paths match that are NOT themselves validated
# artefacts — typically docs, READMEs, or comment-only files. Subtracted
# from the validated set when the gate decides whether a PR is in scope.
# Use sparingly and document any addition in the repo's QMS.
exempt_paths:
  - "**/README.md"
  - "**/*.md"                      # remove this line if the URS itself is in markdown
